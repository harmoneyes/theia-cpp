# Vendored prebuilt binaries are tracked with Git LFS.
# Tracking must be in place before the first binary lands, or it stays in
# history as a plain blob and only a history rewrite removes it.
*.so    filter=lfs diff=lfs merge=lfs -text
*.so.*  filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.lib   filter=lfs diff=lfs merge=lfs -text
# The iOS framework binary has no extension, so it needs its own pattern.
vendor/ios/**/Theia.framework/Theia filter=lfs diff=lfs merge=lfs -text
